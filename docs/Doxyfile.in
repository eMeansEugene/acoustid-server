PROJECT_NAME           = AcoustID Server
PROJECT_BRIEF          = Audio fingerprinting server

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@

INPUT                  = @PROJECT_SOURCE_DIR@/src \
                         @PROJECT_SOURCE_DIR@/docs

EXCLUDE                = @PROJECT_SOURCE_DIR@/docs/html

FILE_PATTERNS          = *.cpp *.h *.md

RECURSIVE              = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/docs/main.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

EXTRACT_ALL            = YES

GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

IMAGE_PATH = @CMAKE_CURRENT_SOURCE_DIR@/modules @CMAKE_CURRENT_SOURCE_DIR@/guides

HTML_EXTRA_STYLESHEET  = @DOXYGEN_AWESOME_DIR@/doxygen-awesome.css